<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);1591</NoWarn>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddBuildTasksOutputToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <PropertyGroup>
        <Description>Provides source generation for Quark and Lucide icons</Description>
        <Version Condition="'$(BUILD_VERSION)' == ''">4.0.0</Version>
        <Version Condition="'$(BUILD_VERSION)' != ''">$(BUILD_VERSION)</Version>
        <AssemblyName>Soenneker.Quark.Gen.Lucide</AssemblyName>
        <PackageId>Soenneker.Quark.Gen.Lucide</PackageId>
        <PackageTags>quark gen lucide icons svg lucidegenerator internalgenerator csharp dotnet c# .net</PackageTags>
        <Copyright>Copyright © 2026 Jake Soenneker</Copyright>
        <Authors>Jake Soenneker</Authors>
        <Company>https://soenneker.com</Company>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/soenneker/soenneker.quark.gen.lucide</PackageProjectUrl>
        <RepositoryUrl>https://github.com/soenneker/soenneker.quark.gen.lucide</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Soenneker.Quark.Gen.Lucide.targets" Pack="true" PackagePath="build/" />
        <None Include="Soenneker.Quark.Gen.Lucide.targets" Pack="true" PackagePath="buildTransitive/" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(TargetDir)$(AssemblyName).pdb" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Quark.Gen.Lucide.Abstractions" Version="4.0.24" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
    </ItemGroup>
    <PropertyGroup>
        <LucideNativeRuntimeIdentifier Condition="'$(LucideNativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</LucideNativeRuntimeIdentifier>
        <LucideNativeArtifactsDir Condition="'$(LucideNativeArtifactsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../artifacts/native'))</LucideNativeArtifactsDir>
        <_LucideNativeExecutable>Soenneker.Quark.Gen.Lucide.BuildTasks</_LucideNativeExecutable>
        <_LucideNativeExecutable Condition="$([System.String]::Copy('$(LucideNativeRuntimeIdentifier)').StartsWith('win-'))">$(_LucideNativeExecutable).exe</_LucideNativeExecutable>
    </PropertyGroup>

    <Target Name="BuildBuildTasksTool" BeforeTargets="Build"
            Condition="'$(LucideUsePrebuiltNativeTools)' != 'true'"
            Inputs="@(LucideNativeSource);../Soenneker.Quark.Gen.Lucide.BuildTasks/obj/project.assets.json"
            Outputs="$(LucideNativeArtifactsDir)/$(LucideNativeRuntimeIdentifier)/$(_LucideNativeExecutable)">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)/../Soenneker.Quark.Gen.Lucide.BuildTasks/Soenneker.Quark.Gen.Lucide.BuildTasks.csproj&quot; --configuration Release --runtime $(LucideNativeRuntimeIdentifier) --output &quot;$(LucideNativeArtifactsDir)/$(LucideNativeRuntimeIdentifier)&quot;" />
    </Target>

    <ItemGroup>
        <LucideNativeSource Include="../Soenneker.Quark.Gen.Lucide.BuildTasks/**/*.cs;../Soenneker.Quark.Gen.Lucide.BuildTasks/*.csproj"
                             Exclude="../Soenneker.Quark.Gen.Lucide.BuildTasks/bin/**;../Soenneker.Quark.Gen.Lucide.BuildTasks/obj/**" />
    </ItemGroup>

    <Target Name="AddBuildTasksOutputToPackage" DependsOnTargets="BuildBuildTasksTool">
        <ItemGroup>
            <_LucideRequiredRuntime Include="win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64" Condition="'$(LucideUsePrebuiltNativeTools)' == 'true'" />
            <_LucideNativeFile Include="$(LucideNativeArtifactsDir)/**/*"
                                Exclude="$(LucideNativeArtifactsDir)/**/*.pdb;$(LucideNativeArtifactsDir)/**/*.dbg;$(LucideNativeArtifactsDir)/**/*.dSYM/**" />
            <TfmSpecificPackageFile Include="@(_LucideNativeFile)" PackagePath="tools/native/" />
        </ItemGroup>
        <Error Condition="'@(_LucideRequiredRuntime)' != '' and !Exists('$(LucideNativeArtifactsDir)/%(_LucideRequiredRuntime.Identity)/Soenneker.Quark.Gen.Lucide.BuildTasks') and !Exists('$(LucideNativeArtifactsDir)/%(_LucideRequiredRuntime.Identity)/Soenneker.Quark.Gen.Lucide.BuildTasks.exe')"
               Text="Missing native lucide tool for %(_LucideRequiredRuntime.Identity)." />
        <Error Condition="'@(_LucideNativeFile)' == ''" Text="Native lucide tools are missing. Publish BuildTasks before packing." />
    </Target>
</Project>
